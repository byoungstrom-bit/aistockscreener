# Finnhub API key for stock data (optional - app uses mock data if missing)
# Get a free key at https://finnhub.io
FINNHUB_API_KEY=

# OpenAI API key for news analysis (optional - app uses mock analysis if missing)
# Get a key at https://platform.openai.com
OPENAI_API_KEY=

# To use: copy this file to .env.local and add your keys
